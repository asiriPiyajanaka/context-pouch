{
  "name": "conpin",
  "displayName": "ConPin",
  "description": "Pin reusable project instructions beside the Codex composer. Experimental, independent integration.",
  "version": "0.4.0",
  "publisher": "asiri-local",
  "icon": "media/logo.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "context",
    "rules",
    "prompt",
    "agent"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "conpin.install",
        "title": "ConPin: Install / Repair Codex Button"
      },
      {
        "command": "conpin.restore",
        "title": "ConPin: Restore Codex"
      },
      {
        "command": "conpin.status",
        "title": "ConPin: Show Status"
      },
      {
        "command": "conpin.graph",
        "title": "ConPin: Open Rule Library"
      },
      {
        "command": "conpin.generate",
        "title": "ConPin: Generate Rules from Project"
      },
      {
        "command": "conpin.setApiKey",
        "title": "ConPin: Set OpenAI API Key"
      }
    ],
    "configuration": {
      "title": "ConPin",
      "properties": {
        "conpin.autoRepatch": {
          "type": "boolean",
          "default": true,
          "description": "Automatically re-apply ConPin after the Codex extension updates, once you have enabled it.",
          "scope": "application"
        },
        "conpin.codexPath": {
          "type": "string",
          "default": "codex",
          "scope": "machine",
          "description": "Codex executable name or absolute path used for project rule generation. Requires a current CLI with --ignore-user-config support."
        }
      }
    },
    "keybindings": [
      {
        "command": "conpin.graph",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.cjs",
    "package": "python3 scripts/package.py",
    "package:verify": "python3 scripts/verify-package.py",
    "test:ui": "node scripts/check-library-ui.cjs && node scripts/check-composer-ui.cjs",
    "recover": "node scripts/recover.cjs"
  },
  "license": "MIT",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/asiriPiyajanaka/context-pouch.git"
  },
  "homepage": "https://github.com/asiriPiyajanaka/context-pouch#readme",
  "bugs": {
    "url": "https://github.com/asiriPiyajanaka/context-pouch/issues"
  },
  "galleryBanner": {
    "color": "#181920",
    "theme": "dark"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "ConPin modifies the Codex extension and can send project instructions to AI providers. Trust the workspace to enable it."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "ConPin requires local files and desktop VS Code."
    }
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "playwright": "1.63.0"
  }
}
